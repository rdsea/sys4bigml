# Copy to .env and fill in what you use. EVERYTHING here is optional:
# with no .env at all, the stack runs on the deterministic mock LLM
# and without Langfuse logging.

# --- Ollama (real local LLM inference) ---------------------------------------
# Install Ollama (https://ollama.com), pull a model (e.g. `ollama pull llama3.2`),
# then uncomment:
#OLLAMA_HOST=host.docker.internal
#OLLAMA_PORT=11434
#OLLAMA_MODEL=llama3.2

# --- Langfuse (detailed LLM interaction logging) -----------------------------
# Self-host Langfuse (see README step 2), create a project, then paste the
# project keys:
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_HOST=http://host.docker.internal:3000

# --- Overrides (defaults shown; normally leave commented) --------------------
#OTEL_EXPORTER_OTLP_ENDPOINT_GRPC=http://otel-collector:4317
#AGENT_OTEL_SERVICE_NAME=agent_service
#HUMAN_OTEL_SERVICE_NAME=human_service
#DETECTION_OTEL_SERVICE_NAME=detection_service
#DETECTION_SERVICE_API_URL=http://detection_service:8000
#HUMAN_SERVICE_API_URL=http://human_service:8002/review
